{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keepo",
  "main": "_worker.js",
  "compatibility_date": "2026-05-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Rate-limiting natif Cloudflare Workers (anti-abus / anti-coût).
  // period = 60 s (seules 10 ou 60 sont acceptées). Clé = id du commerçant.
  "ratelimits": [
    { "name": "AI_LIMITER",       "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "CAMPAIGN_LIMITER", "namespace_id": "1002", "simple": { "limit": 3,  "period": 60 } },
    // La saisie d'adresse produit un appel par pause de frappe : la limite
    // doit etre large, le service appele est gratuit et public.
    { "name": "ADDR_LIMITER",     "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
  // Aucune clé secrète ici : RESEND_API_KEY, STRIPE_*, SUPABASE_SERVICE_ROLE et
  // GEMINI_API_KEY sont gérés via `npx wrangler secret put <NOM>` (jamais en clair).
}
